# Public site URL — used for canonical links, sitemap.xml, robots.txt and Open Graph tags.
# Defaults to the live Vercel deployment if this isn't set. Update once a
# custom domain (e.g. milasengenharia.co.mz) is connected.
NEXT_PUBLIC_SITE_URL=https://milas-engenharia.vercel.app

# --- RFQ form email delivery -----------------
# Required to receive orçamento requests by email. Get a free API key at
# https://resend.com (free tier covers small volumes).
RESEND_API_KEY=

# Where RFQ submissions are sent. Defaults to milas.engenharia@gmail.com
# if left unset.
RFQ_NOTIFICATION_EMAIL=milas.engenharia@gmail.com

# The "from" address emails are sent from. Resend's shared test address
# (onboarding@resend.dev) works immediately with no setup, but delivers
# less reliably long-term and can't use your own domain name. For a
# production site, verify a domain in Resend and use an address on it,
# e.g. "Milas Engenharia <rfq@milasengenharia.co.mz>".
RESEND_FROM_EMAIL=Site Milas Engenharia <onboarding@resend.dev>

# --- Analytics (optional) -----------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
